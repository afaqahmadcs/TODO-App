# ==============================================================================
# Afaq TaskFlow - Environment Variables Template
# Production Deployment for Vercel & Supabase
# ==============================================================================

# Supabase Project Connection (Client-Safe Public Variables)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Application Base URL
# Local development: http://localhost:3000
# Production deployment: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# SECURITY NOTICE:
# NEVER commit .env or .env.local to version control!
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the client bundle or NEXT_PUBLIC_*!
# Row Level Security (RLS) policies enforce multi-tenant isolation via anon key.
# ==============================================================================
